# =====================================================================
# ARIA Environment Configuration
# =====================================================================

# Default LLM Provider: 'groq' or 'ollama'
LLM_PROVIDER=groq

# Groq API Configuration (Free at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama Configuration (Local, no API key needed)
# Default model: gemma4:12b-mlx or llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma4:12b-mlx

# Agent Execution Limits
MAX_STEPS=15
TIMEOUT_SECONDS=60
